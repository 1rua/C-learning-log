{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: cl.exe 编译活动文件",
            "type": "shell",
            "command": "cl.exe",
            "args": [
                "/nologo",
                "/EHsc",
                "${file}",
                "/Fe:${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "${env:PATH};D:\\Program Files\\visual studio\\visual studio\\VC\\Tools\\MSVC\\14.50.35717\\bin\\Hostx64\\x64;D:\\Program Files\\visual studio\\visual studio\\VC\\Auxiliary\\Build",
                    "INCLUDE": "${env:INCLUDE};D:\\Program Files\\visual studio\\visual studio\\VC\\Tools\\MSVC\\14.50.35717\\include;D:\\Program Files\\visual studio\\visual studio\\VC\\Auxiliary\\VS\\include",
                    "LIB": "${env:LIB};D:\\Program Files\\visual studio\\visual studio\\VC\\Tools\\MSVC\\14.50.35717\\lib\\x64;D:\\Program Files\\visual studio\\visual studio\\VC\\Auxiliary\\VS\\lib\\x64"
                }
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "编译器: cl.exe (自动设置环境)"
        },
        {
            "label": "C/C++: cl.exe 编译并运行",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "cl.exe /nologo /EHsc \"${file}\" /Fe:\"${fileDirname}\\${fileBasenameNoExtension}.exe\" && \"${fileDirname}\\${fileBasenameNoExtension}.exe\""
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "${env:PATH};D:\\Program Files\\visual studio\\visual studio\\VC\\Tools\\MSVC\\14.50.35717\\bin\\Hostx64\\x64;D:\\Program Files\\visual studio\\visual studio\\VC\\Auxiliary\\Build",
                    "INCLUDE": "${env:INCLUDE};D:\\Program Files\\visual studio\\visual studio\\VC\\Tools\\MSVC\\14.50.35717\\include;D:\\Program Files\\visual studio\\visual studio\\VC\\Auxiliary\\VS\\include",
                    "LIB": "${env:LIB};D:\\Program Files\\visual studio\\visual studio\\VC\\Tools\\MSVC\\14.50.35717\\lib\\x64;D:\\Program Files\\visual studio\\visual studio\\VC\\Auxiliary\\VS\\lib\\x64"
                }
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build",
            "detail": "编译并运行: cl.exe (自动设置环境)"
        },
        {
            "label": "C/C++: 清理编译文件",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "del \"${fileDirname}\\*.obj\" \"${fileDirname}\\*.exe\""
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [],
            "detail": "清理编译生成的文件"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe 生成活动文件",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "调试器生成的任务。"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc 生成活动文件",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ]
}